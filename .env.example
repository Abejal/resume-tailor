# Copy to .env and fill in real values. Never commit .env.

# Supabase (frontend)
VITE_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-key"
VITE_SUPABASE_PROJECT_ID="your-project-id"

# App
VITE_APP_URL="http://localhost:8080"

# ---- Edge function secrets (set via `npx supabase secrets set ...`) ----
# LLM fallback chain (order): Gemini key 1..3 -> OpenRouter -> Groq.
# Only the ones you set are used; the router skips any that are absent.
# GOOGLE_AI_API_KEY=                          # Gemini key 1 (aistudio.google.com/app/apikey)
# GOOGLE_AI_API_KEY_2=                        # Gemini key 2 (DIFFERENT Google account = own free quota)
# GOOGLE_AI_API_KEY_3=                        # Gemini key 3 (optional)
# GEMINI_MODEL=gemini-2.5-flash               # 2.0-flash has NO free quota on some keys — keep 2.5
# OPENROUTER_API_KEY=                         # openrouter.ai/keys — one key, many models
# OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free   # any OpenRouter model slug
# GROQ_API_KEY=                               # Groq key for Llama 3.3 70B (final fallback)
#
# TOYYIBPAY_BASE_URL=https://dev.toyyibpay.com   # sandbox; use https://toyyibpay.com for live
# TOYYIBPAY_SECRET_KEY=                          # from toyyibpay dashboard → Profile → API
# TOYYIBPAY_CATEGORY_CODE=                       # create one category in toyyibpay, paste its code
# TOYYIBPAY_PRICE_MONTHLY=2900                   # RM29.00 in cents
# TOYYIBPAY_PRICE_ANNUAL=29000                   # RM290.00 in cents
# TOYYIBPAY_PRICE_TOPUP=1000                     # RM10.00 in cents
#
# ALLOWED_ORIGIN=https://your-prod-domain.com
